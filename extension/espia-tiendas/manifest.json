{
  "manifest_version": 3,
  "name": "ImporKiller IMPORCHAT",
  "version": "0.6.7",
  "description": "Ventas estimadas debajo de cada producto de Dropi, y los anuncios de la Biblioteca de Meta agrupados por producto, con días activos y descarga de creativos.",
  "permissions": ["downloads", "storage"],
  "host_permissions": [
    "https://www.facebook.com/ads/library/*",
    "https://*.fbcdn.net/*",
    "https://app.dropi.ec/*",
    "https://app.dropi.mx/*",
    "https://app.dropi.co/*",
    "https://app.dropi.pe/*",
    "https://app.dropi.cl/*",
    "https://app.dropi.ar/*",
    "https://app.dropi.pa/*",
    "https://app.dropi.cr/*",
    "https://app.dropi.gt/*",
    "https://app.dropi.com.py/*",
    "https://app.dropi.com.ve/*",
    "https://*.imporfactory.app/*",
    "https://*.imporsuit.ec/*",
    "https://*.imporsuitpro.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "ImporKiller IMPORCHAT",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_page": "options.html",
  "background": { "service_worker": "bg.js" },
  "content_scripts": [
    {
      "matches": ["https://app.dropi.ec/*", "https://app.dropi.mx/*", "https://app.dropi.co/*", "https://app.dropi.pe/*", "https://app.dropi.cl/*", "https://app.dropi.ar/*", "https://app.dropi.pa/*", "https://app.dropi.cr/*", "https://app.dropi.gt/*", "https://app.dropi.com.py/*", "https://app.dropi.com.ve/*"],
      "js": ["dropi-captura.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://app.dropi.ec/*", "https://app.dropi.mx/*", "https://app.dropi.co/*", "https://app.dropi.pe/*", "https://app.dropi.cl/*", "https://app.dropi.ar/*", "https://app.dropi.pa/*", "https://app.dropi.cr/*", "https://app.dropi.gt/*", "https://app.dropi.com.py/*", "https://app.dropi.com.ve/*"],
      "js": ["dropi.js"],
      "css": ["dropi.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.facebook.com/ads/library/*"],
      "js": ["captura.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.facebook.com/ads/library/*"],
      "js": ["barra.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatcenter.imporfactory.app/*",
        "https://dev.imporfactory.app/*",
        "https://new.imporsuitpro.com/*",
        "https://desarrollo.imporsuitpro.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["sesion.js"],
      "run_at": "document_idle"
    }
  ]
}
