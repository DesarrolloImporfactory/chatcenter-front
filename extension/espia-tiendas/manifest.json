{
  "manifest_version": 3,
  "name": "Espía de tiendas IMPORCHAT",
  "version": "0.2.0",
  "description": "Agrupa por producto los anuncios de una tienda en la Biblioteca de anuncios de Meta, los baja a una carpeta y los manda a IMPORCHAT.",
  "permissions": ["downloads", "storage"],
  "host_permissions": [
    "https://www.facebook.com/ads/library/*",
    "https://*.fbcdn.net/*",
    "https://*.imporfactory.app/*",
    "https://*.imporsuit.ec/*",
    "https://*.imporsuitpro.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Espía de tiendas IMPORCHAT",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_page": "options.html",
  "background": { "service_worker": "bg.js" },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/ads/library/*"],
      "js": ["captura.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.facebook.com/ads/library/*"],
      "js": ["barra.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatcenter.imporfactory.app/*",
        "https://dev.imporfactory.app/*",
        "https://new.imporsuitpro.com/*",
        "https://desarrollo.imporsuitpro.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["sesion.js"],
      "run_at": "document_idle"
    }
  ]
}
